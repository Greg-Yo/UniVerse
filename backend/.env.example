# ============================================================================
# UniVerse Backend - Variables d'environnement (exemple)
# Copier ce fichier en `.env` et renseigner les valeurs reelles.
# NE JAMAIS committer le fichier .env reel.
# Generer des secrets forts, ex. : openssl rand -base64 48
# ============================================================================

# --- Application ---
# Production : docker compose up -d
# Dev (ports Postgres/Redis/MinIO sur localhost) :
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
NODE_ENV=development
PORT=3000
# URL publique de l'API (utilisee par Swagger, liens, etc.)
APP_URL=http://localhost:3000
# Origines autorisees pour CORS (separees par des virgules).
# OBLIGATOIRE en production (le process refuse de demarrer si vide).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# L6 : activer trust proxy derriere Caddy/nginx (X-Forwarded-For / rate-limit).
# En production : true par defaut sauf TRUST_PROXY=false.
# TRUST_PROXY=true

# --- PostgreSQL ---
POSTGRES_USER=universe
POSTGRES_PASSWORD=CHANGE_ME_postgres_strong_password
POSTGRES_DB=universe
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Connexion applicative (role NON superuser => la RLS s'applique)
DATABASE_URL=postgresql://universe_app:CHANGE_ME_app_password@postgres:5432/universe?schema=public
# Connexion d'administration (role owner => pour les migrations Prisma)
DIRECT_URL=postgresql://universe:CHANGE_ME_postgres_strong_password@postgres:5432/universe?schema=public
# Mot de passe du role applicatif (cree par l'init Docker / migration RLS)
APP_DB_PASSWORD=CHANGE_ME_app_password

# --- JWT (min. 32 caracteres aleatoires, secrets distincts) ---
JWT_ACCESS_SECRET=CHANGE_ME_access_secret_min_32_chars_long_xxxx
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=CHANGE_ME_refresh_secret_min_32_chars_long_xxx
JWT_REFRESH_TTL=2592000

# --- Redis (BullMQ + Socket.io adapter) ---
# OBLIGATOIRE en production.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_redis_strong_password
# L10 : TLS Redis (reseau non de confiance / Redis manage). Docker interne : false.
REDIS_TLS=false

# --- MinIO (stockage fichiers S3-compatible) ---
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# L10 : HTTPS MinIO si expose hors reseau Docker de confiance.
MINIO_USE_SSL=false
MINIO_ROOT_USER=universe_minio
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_strong_password
MINIO_ACCESS_KEY=universe_minio
MINIO_SECRET_KEY=CHANGE_ME_minio_strong_password
MINIO_BUCKET_RESOURCES=resources
MINIO_BUCKET_LIBRARY=library
# URL publique pour la generation d'URLs pre-signees exposees au client
MINIO_PUBLIC_URL=http://localhost:9000
# Duree de validite des URLs pre-signees (secondes)
MINIO_PRESIGN_TTL=900
# Plafonds upload (octets) — signes dans la policy POST MinIO
MINIO_MAX_UPLOAD_RESOURCES=104857600
MINIO_MAX_UPLOAD_LIBRARY=524288000

# --- YouTube Data API v3 (hebergement video, mode non repertorie) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:3000/video/youtube/callback
# Refresh token du compte YouTube institutionnel (jamais expose via HTTP)
YOUTUBE_REFRESH_TOKEN=
# Fichier optionnel ou le callback OAuth ecrit le refresh token (mode 0600)
# YOUTUBE_REFRESH_TOKEN_FILE=/run/secrets/youtube_refresh_token
# Activer une fois le bootstrap OAuth en production :
# ALLOW_YOUTUBE_OAUTH_BOOTSTRAP=true
# Fichier one-time pour le state CSRF OAuth (multi-instance) :
# YOUTUBE_OAUTH_STATE_FILE=/run/secrets/youtube_oauth_state

# --- Cookies refresh (HttpOnly) ---
# En production : Secure=true automatiquement si NODE_ENV=production.
# COOKIE_SECURE=true
# En dev, le jeton de verification email est renvoye dans la reponse register.
# En prod, brancher un fournisseur email ; pour tests :
# EXPOSE_EMAIL_VERIFICATION_TOKEN=true
# Autoriser refresh token dans le body (dev/tests uniquement) :
# ALLOW_REFRESH_BODY=true
# Lockout login (echecs / fenetre) :
LOGIN_MAX_FAILURES=8
LOGIN_LOCKOUT_SEC=900
# Chemin frontend de verification (doit accepter ?token=...).
EMAIL_VERIFY_PATH=/verify-email

# --- SMTP transactionnel (Postmark/Brevo/SES SMTP) ---
# Obligatoire en production si EXPOSE_EMAIL_VERIFICATION_TOKEN n'est pas active.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@universe.example
MAIL_APP_NAME=UniVerse

# --- Seed (obligatoire pour `npm run db:seed`) ---
SEED_SUPERADMIN_EMAIL=superadmin@example.com
SEED_SUPERADMIN_PASSWORD=CHANGE_ME_seed_password_12chars!

# --- Sentry (monitoring erreurs) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Regle metier ---
# Fenetre de reponse Enseignant en heures (cf. EN-3, section 3.6)
CONVERSATION_TEACHER_WINDOW_HOURS=24
